{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window exports may write only to paths selected in a native Save dialog.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "fs:allow-write-file"
  ]
}
