# Frontend environment values for Vite/Tauri.
# Copy this file to .env.local and fill in real values locally.
# Do not commit .env.local.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional app metadata.
VITE_APP_VERSION=0.1.0

# Optional idle/session lock.
# Number of idle minutes before the app locks the session.
VITE_IDLE_LOCK_MINUTES=15

# Optional mobile upload / invite links.
# Leave blank to use the app's built-in default behavior.
VITE_MOBILE_UPLOAD_BASE_URL=
VITE_CARE_TEAM_INVITE_REDIRECT_URL=
VITE_INVITE_REDIRECT_URL=

# Optional About update checking.
# VITE_APP_UPDATE_MANIFEST_URL can point to a small JSON file like:
# { "latest_version": "0.1.1", "release_url": "https://example.com/releases", "notes": ["Change 1"] }
# If no manifest is available, VITE_APP_UPDATE_URL opens a manual release/download page.
VITE_APP_UPDATE_MANIFEST_URL=
VITE_APP_UPDATE_URL=
