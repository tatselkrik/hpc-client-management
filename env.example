# Frontend environment values for Vite/Tauri.
# Copy this file to .env.local and fill in real values locally.
# Do not commit .env.local.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Desktop invitation scheme for your own deployment.
VITE_AUTH_DEEP_LINK_SCHEME=hpc-client-management

# Public-source app metadata. Override these only in an untracked local file.
VITE_APP_VERSION=0.3.5
VITE_APP_CHANNEL=stable
VITE_APP_IDENTIFIER=com.example.hpcclientmanagement
VITE_CLINIC_NAME=Sample Psychological Center
VITE_CLINIC_MOBILE=
VITE_CLINIC_LANDLINE=
VITE_CLINIC_EMAIL=
VITE_CLINIC_ADDRESS=

# Optional idle/session lock.
# Number of idle minutes before the app locks the session.
VITE_IDLE_LOCK_MINUTES=15

# Optional mobile upload links.
# Keep disabled until the separate phone page, hosting, privacy review, and
# end-to-end upload security tests are complete.
VITE_ENABLE_MOBILE_UPLOAD=false
VITE_MOBILE_UPLOAD_BASE_URL=

# Optional About update checking for a privately configured deployment.
VITE_APP_UPDATE_MANIFEST_URL=
VITE_APP_UPDATE_URL=
